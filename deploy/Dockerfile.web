# averin web app + standalone verifier, served statically. Builds the Svelte SPA and the WASM for the
# offline verifier, then serves both via nginx.
#
# SUPPLY CHAIN — pin base images by digest for production (tags below float). Resolve with:
#   docker buildx imagetools inspect <image:tag> --format '{{.Manifest.Digest}}'
# then write `FROM <image:tag>@sha256:<digest>`. The .wasm built here is the verifier TRUST ROOT; its exact
# rustc is governed by rust-toolchain.toml, and the published digest is pinned per verifier/SUPPLY-CHAIN.md.
FROM rust:1-bookworm AS wasmbuild
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY core ./core
RUN rustup target add wasm32-unknown-unknown \
 && cargo build -p averin-decision-core --release --target wasm32-unknown-unknown --no-default-features

FROM oven/bun:1 AS webbuild
WORKDIR /src/web
COPY web/package.json web/bun.lock* ./
RUN bun install --frozen-lockfile || bun install
COPY web .
RUN bun run build

FROM nginx:1-alpine
COPY --from=webbuild /src/web/dist /usr/share/nginx/html
COPY verifier /usr/share/nginx/html/verifier
COPY --from=wasmbuild /src/target/wasm32-unknown-unknown/release/averin_decision_core.wasm /usr/share/nginx/html/verifier/averin_decision_core.wasm
# SELF-PIN: rewrite the served index.html's WASM_SHA256 (and the sidecar) to the digest of the wasm ACTUALLY
# built+served HERE. The committed pin was generated on a dev host; wasm32 codegen is NOT bit-identical across
# build hosts, so a static pin would not match this freshly-built binary and the fail-closed loader would
# refuse to start the deployed verifier. Pinning what we serve makes served==pinned by construction. (Source
# reproduction/transparency is a separate property — see verifier/SUPPLY-CHAIN.md.)
RUN d="$(sha256sum /usr/share/nginx/html/verifier/averin_decision_core.wasm | cut -d' ' -f1)" \
 && sed -i "s|const WASM_SHA256 = \"sha256:[0-9a-f]*\"|const WASM_SHA256 = \"sha256:$d\"|" /usr/share/nginx/html/verifier/index.html \
 && printf 'sha256:%s  averin_decision_core.wasm\n' "$d" > /usr/share/nginx/html/verifier/averin_decision_core.wasm.sha256 \
 && grep -q "sha256:$d" /usr/share/nginx/html/verifier/index.html  # fail the build if the pin didn't take
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
