# feir web app + standalone verifier, served statically. Builds the Svelte SPA and the WASM for the
# offline verifier, then serves both via nginx.
FROM rust:1-bookworm AS wasmbuild
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY core ./core
RUN rustup target add wasm32-unknown-unknown \
 && cargo build -p feir-decision-core --release --target wasm32-unknown-unknown --no-default-features

FROM oven/bun:1 AS webbuild
WORKDIR /src/web
COPY web/package.json web/bun.lock* ./
RUN bun install --frozen-lockfile || bun install
COPY web .
RUN bun run build

FROM nginx:1-alpine
COPY --from=webbuild /src/web/dist /usr/share/nginx/html
COPY verifier /usr/share/nginx/html/verifier
COPY --from=wasmbuild /src/target/wasm32-unknown-unknown/release/feir_decision_core.wasm /usr/share/nginx/html/verifier/feir_decision_core.wasm
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
