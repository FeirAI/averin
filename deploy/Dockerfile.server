# averin server + proxy. Multi-stage: build the Rust integrity core (staticlib), then the cgo Go
# binaries, then a slim runtime. The Go services link the SAME Rust core the CLI/WASM use.
#
# SUPPLY CHAIN — pin base images by digest for production. The tags below float (a `:1-bookworm` can be
# re-pushed under you). Resolve and append the digest before deploying, e.g.:
#   docker buildx imagetools inspect rust:1-bookworm --format '{{.Manifest.Digest}}'
#   FROM rust:1-bookworm@sha256:<digest> AS rustbuild
# The EXACT rustc used to build the core is governed by rust-toolchain.toml (rustup honors it inside the
# container regardless of the rust: image's default), so the staticlib is reproducible independent of this tag.
FROM rust:1-bookworm AS rustbuild
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY core ./core
# PROD: build the integrity core --release (optimized; the debug core is a perf/correctness
# footgun for the trust root). We copy the RELEASE staticlib into the target/debug path the cgo
# LDFLAGS (${SRCDIR}/../../../target/debug) expect, so the prod image links the optimized core
# WITHOUT changing the source #cgo directive (local dev still builds debug unchanged).
RUN cargo build --release -p averin-decision-core

FROM golang:1.25-bookworm AS gobuild
WORKDIR /src
COPY . .
COPY --from=rustbuild /src/target/release/libaverin_decision_core.a ./target/debug/libaverin_decision_core.a
WORKDIR /src/server
RUN CGO_ENABLED=1 go build -o /out/averin-server ./cmd/averin-server \
 && CGO_ENABLED=1 go build -o /out/averin-proxy  ./cmd/averin-proxy

FROM debian:bookworm-slim
# Pin a NUMERIC uid/gid so k8s `runAsNonRoot` + `runAsUser: 65532` can verify non-root (the
# kubelet does not resolve USER names). Without a fixed uid, a name-only USER fails under
# PodSecurity=restricted. 65532 matches the distroless `nonroot` convention used by the Go planes.
RUN groupadd -g 65532 averin && useradd -u 65532 -g 65532 -m averin
COPY --from=gobuild /out/averin-server /usr/local/bin/averin-server
COPY --from=gobuild /out/averin-proxy  /usr/local/bin/averin-proxy
COPY spec/fixtures /opt/averin/fixtures
USER averin
EXPOSE 8080 8081
ENV AVERIN_ADDR=:8080
CMD ["averin-server"]
