# image.yml.example — averin's caller for the shared image supply-chain action (integration#18 slot 4).
# INERT until activated: GitHub Actions only loads *.yml/*.yaml under .github/workflows/, so this
# .yml.example never runs. To ARM it: (1) rename to `image.yml`, (2) set the `uses:` ref below to the
# real `<owner>/feir-os/deploy/k8s/ci@<40-char-sha>`, (3) set repo vars/secrets. Publishes the cgo Go
# server image (`averin-server`) the prod overlay pins. See feir-os/deploy/k8s/ci/IMAGES.md.
name: image
on:
  push:
    branches: [main]
    tags: ["v*"]
  pull_request:            # PRs build-only (no push/sign) for validation

permissions:
  contents: read
  id-token: write          # REQUIRED for keyless cosign (Sigstore OIDC)
  packages: write          # if using GHCR; drop for other registries

jobs:
  image:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: REPLACE_OWNER/feir-os/deploy/k8s/ci@REPLACE_ACTION_SHA   # pin to a full 40-char commit SHA
        with:
          registry: ${{ vars.REGISTRY_HOST }}      # e.g. ghcr.io
          image: ${{ vars.IMAGE_REPO }}            # e.g. acme/averin-server
          tag: ${{ github.ref_name }}
          dockerfile: ./deploy/Dockerfile.server   # averin: the cgo Go server (Dockerfile.web is NOT deployed by feir-os)
          registry-username: ${{ secrets.REGISTRY_USER }}
          registry-password: ${{ secrets.REGISTRY_TOKEN }}
          push: ${{ github.event_name != 'pull_request' }}
