    "std_models": {
      "core.str.Str.as_bytes": "identity (Aeneas represents &str by its UTF-8 bytes)",
      "alloc.string.String.as_bytes": "UTF-8 bytes of the Lean String modelling the Rust String; fails only above usize::MAX bytes",
      "alloc.string.String.Insts.CoreOpsDerefDerefStr.deref": "same bytes as String::as_bytes",
      "alloc.string.String.from_utf8": "Ok with exactly the given bytes iff they are valid UTF-8 (Lean's verified String.fromUTF8?)",
      "alloc.string.FromUtf8Error": "Unit; never inspected",
      "averin_decision_core.toStr": "Aeneas.Std.toStr with a kernel-checked (not native) size bound for string literals",
      "alloc.string.String.is_empty": "true exactly when the Lean String modelling the Rust String has no UTF-8 bytes; total",
