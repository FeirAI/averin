        authenticated,
        authorized,
        historical_authorized_as_of_snapshot,
        temporal,
        complete_brokered,
        complete_introspected,
        requested := verify.verdict.RequestedClaim.CompleteIntrospected,
        requested_decision := complete_introspected
      }

