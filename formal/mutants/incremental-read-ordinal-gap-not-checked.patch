diff --git a/server/internal/api/incremental_read.go b/server/internal/api/incremental_read.go
--- a/server/internal/api/incremental_read.go
+++ b/server/internal/api/incremental_read.go
@@ -127,7 +127,7 @@ func (s *Server) handleIncrementalRead(w http.ResponseWriter, r *http.Request, p
 	// would repeat one record and hide another under a 200. The page must be exactly after+1..after+len, and
 	// a page that stops short of the total must end at it. An empty page past the total is a reader that is
 	// ahead of the store (a truncation it reads from total), not a gap.
-	if err := ordinalGap(p.after, page, total, p.limit); err != nil {
+	if err := ordinalGap(p.after, page, total, p.limit); err != nil && false {
 		writeErr(w, http.StatusInternalServerError, err.Error())
 		return
 	}
